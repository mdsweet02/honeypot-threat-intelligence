# Copy to .env  (cp .env.example .env && chmod 600 .env)  - .env is git-ignored. NEVER commit it.

# --- Telegram (docs/02-telegram-bot-setup.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OSINT enrichment API keys (free tiers) ---
VT_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# --- Your own public IP(s), comma separated: excluded from alerts, stats and IOC feed ---
OWN_IPS=

# --- Tuning (defaults shown) ---
# ALERT_COOLDOWN_SECONDS=3600     # same IP + same rule alerts at most once per hour
# ALERT_MAX_PER_HOUR=30           # global Telegram flood cap
# DISK_ALERT_PERCENT=80
# LOG_STALE_MINUTES=30
# COWRIE_LOG_DIR=/opt/honeypot/data/cowrie/log
